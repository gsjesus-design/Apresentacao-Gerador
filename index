<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Gerador de Relatório — Contratação Motoristas</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<style>
:root{--blue:#073763;--yellow:#FFE600;--gray:#3d3d3d;--light:#f5f5f0;--white:#fff;--muted:#888;--border:#e2e2dc;--radius:8px}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--light);color:var(--gray);min-height:100vh}
header{background:var(--blue);border-bottom:4px solid var(--yellow);padding:20px 32px;display:flex;align-items:center;gap:16px}
.header-logo{width:36px;height:36px;background:var(--yellow);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;color:var(--blue)}
header h1{color:#fff;font-size:17px;font-weight:600}
header p{color:rgba(255,255,255,.6);font-size:12px;margin-top:2px}
.container{max-width:860px;margin:0 auto;padding:40px 24px}
.card{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:28px;margin-bottom:20px}
.card-title{font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--blue);margin-bottom:16px;display:flex;align-items:center;gap:8px}
.card-title::before{content:'';display:inline-block;width:3px;height:14px;background:var(--yellow);border-radius:2px}
label{font-size:13px;font-weight:500;color:var(--gray);display:block;margin-bottom:6px}
input[type=text],input[type=date]{width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:6px;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--gray);background:var(--light);outline:none;transition:border .2s}
input:focus{border-color:var(--blue);background:#fff}
.field{margin-bottom:16px}
.field-hint{font-size:11px;color:var(--muted);margin-top:4px}
.abas-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.aba-badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;color:var(--blue);background:rgba(7,55,99,.07);padding:3px 8px;border-radius:4px;margin-bottom:4px;width:fit-content}
.btn-generate{width:100%;padding:14px;background:var(--blue);color:#fff;border:none;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:opacity .2s;display:flex;align-items:center;justify-content:center;gap:10px}
.btn-generate:hover{opacity:.88}
.btn-generate:disabled{opacity:.5;cursor:not-allowed}
#status-area{display:none;margin-top:16px}
.status-bar{background:var(--light);border:1px solid var(--border);border-radius:6px;padding:14px 16px;font-size:13px;color:var(--gray);display:flex;align-items:center;gap:10px}
.status-bar.loading{border-color:var(--blue);background:rgba(7,55,99,.04)}
.status-bar.success{border-color:#16a34a;background:rgba(22,163,74,.05);color:#15803d}
.status-bar.error{border-color:#dc2626;background:rgba(220,38,38,.05);color:#dc2626}
.spinner{width:16px;height:16px;border:2px solid rgba(7,55,99,.2);border-top-color:var(--blue);border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.steps{display:flex;flex-direction:column;gap:8px}
.step{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--muted)}
.step.done{color:#16a34a}
.step.active{color:var(--blue);font-weight:500}
.step-dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--border);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:10px}
.step.done .step-dot{background:#16a34a;border-color:#16a34a;color:#fff}
.step.active .step-dot{background:var(--blue);border-color:var(--blue);color:#fff}
#preview-area{display:none;margin-top:20px}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.stat-card{background:var(--light);border:1px solid var(--border);border-radius:6px;padding:14px;text-align:center}
.stat-num{font-size:26px;font-weight:700;color:var(--blue);line-height:1}
.stat-label{font-size:11px;color:var(--muted);margin-top:4px}
.btn-download{width:100%;padding:14px;background:var(--yellow);color:var(--blue);border:none;border-radius:6px;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:700;cursor:pointer;transition:opacity .2s;display:flex;align-items:center;justify-content:center;gap:10px}
.btn-download:hover{opacity:.88}
.info-box{background:rgba(7,55,99,.05);border:1px solid rgba(7,55,99,.15);border-radius:6px;padding:14px 16px;font-size:12px;color:var(--blue);line-height:1.6}
</style>
</head>
<body>
<header>
  <div class="header-logo">M</div>
  <div>
    <h1>Gerador de Relatório Diário</h1>
    <p>Contratação de Motoristas · Mercado Livre</p>
  </div>
</header>
<div class="container">
  <div class="card">
    <div class="card-title">Configuração</div>
    <div class="field">
      <label>Link da Planilha Google Sheets</label>
      <input type="text" id="sheet-url" placeholder="https://docs.google.com/spreadsheets/d/..." value="https://docs.google.com/spreadsheets/d/1KxTTt7ro_oSO2EMEfrc3KrlbuyM4eXMUCdkDGpXaJlM/edit">
      <div class="field-hint">A planilha precisa estar compartilhada como "Qualquer pessoa com o link pode visualizar"</div>
    </div>
    <div class="field">
      <label>Data do Relatório</label>
      <input type="date" id="report-date">
    </div>
    <div class="field">
      <label>Nome das Abas</label>
      <div class="abas-grid">
        <div><span class="aba-badge">🎣 Pesca</span><input type="text" id="aba-pesca" value="Análise Pesca" style="font-size:12px;padding:7px 10px"></div>
        <div><span class="aba-badge">🔍 GUEP</span><input type="text" id="aba-guep" value="GUEP" style="font-size:12px;padding:7px 10px"></div>
        <div><span class="aba-badge">✅ Contratação</span><input type="text" id="aba-cont" value="Análise Contratação" style="font-size:12px;padding:7px 10px"></div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">Como funciona</div>
    <div class="info-box">
      O gerador busca os dados direto das abas do Google Sheets, filtra automaticamente pela <strong>Data</strong> selecionada (formato DD/MM/AAAA na planilha) e gera o relatório HTML completo com todas as abas, gráficos e resumo para WhatsApp.
    </div>
  </div>
  <button class="btn-generate" id="btn-generate" onclick="gerarRelatorio()">⚡ Gerar Relatório</button>
  <div id="status-area">
    <div class="status-bar loading" id="status-bar">
      <div class="spinner" id="spinner"></div>
      <span id="status-text">Iniciando...</span>
    </div>
    <div class="steps" id="steps-area" style="margin-top:12px;padding:0 4px">
      <div class="step" id="step-1"><div class="step-dot">1</div> Buscando aba Pesca...</div>
      <div class="step" id="step-2"><div class="step-dot">2</div> Buscando aba GUEP...</div>
      <div class="step" id="step-3"><div class="step-dot">3</div> Buscando aba Contratação...</div>
      <div class="step" id="step-4"><div class="step-dot">4</div> Processando e gerando relatório...</div>
    </div>
  </div>
  <div id="preview-area">
    <div class="card">
      <div class="card-title">Prévia</div>
      <div class="stats-grid" id="stats-grid"></div>
      <button class="btn-download" id="btn-download">⬇️ Baixar Relatório HTML</button>
    </div>
  </div>
</div>
<script>
function getSheetId(url){const m=url.match(/\/d\/([a-zA-Z0-9_-]+)/);return m?m[1]:null;}
function csvUrl(id,aba){return `https://docs.google.com/spreadsheets/d/${id}/gviz/tq?tqx=out:csv&sheet=${encodeURIComponent(aba)}`;}
function setStep(n,state){const el=document.getElementById(`step-${n}`);el.className=`step ${state}`;if(state==='done')el.querySelector('.step-dot').textContent='✓';if(state==='active')el.querySelector('.step-dot').textContent=n;}
function setStatus(msg,type='loading'){document.getElementById('status-text').textContent=msg;document.getElementById('status-bar').className=`status-bar ${type}`;document.getElementById('spinner').style.display=type==='loading'?'block':'none';}
async function fetchCSV(url){const r=await fetch(url);if(!r.ok)throw new Error(`HTTP ${r.status} ao buscar dados`);const t=await r.text();return new Promise((res,rej)=>{Papa.parse(t,{header:true,skipEmptyLines:true,complete:r=>res(r.data),error:e=>rej(e)});});}
function normDate(d){if(!d)return '';d=d.trim().split(' ')[0];if(d.includes('/'))return d;if(d.includes('-')){const[y,m,dd]=d.split('-');return `${dd}/${m}/${y}`;}return d;}
function normCPF(c){return(c||'').replace(/[.\-\/\s]/g,'').trim();}
function filterByDate(rows,dateVal){if(!dateVal)return rows;const[y,m,d]=dateVal.split('-');const target=`${d}/${m}/${y}`;return rows.filter(r=>{const col=r['Data']||r['data']||r['DATA']||'';return normDate(col)===target;});}
function getCol(row,...keys){for(const k of keys){if(row[k]!==undefined&&row[k]!=='')return(row[k]||'').trim();}return '';}
function mapPesca(rows){return rows.map(r=>({a:getCol(r,'Assistente','assistente'),n:getCol(r,'Nome','nome','Nome do Motorista'),c:normCPF(getCol(r,'CPF','cpf','CPF MOTORISTA - SOMENTE NUMERO')),v:getCol(r,'Perfil do Veículo','Perfil Veículo','Perfil do Ve\u00edculo'),m:getCol(r,'Milha','milha'),b:getCol(r,'Base','base'),r:getCol(r,'Regional','regional'),g:getCol(r,'Status GUEP','status_guep','Status')})).filter(r=>r.n);}
function mapGUEP(rows){return rows.map(r=>({r:getCol(r,'RESPONSÁVEL','Responsável','responsavel'),n:getCol(r,'Nome do Motorista','Nome','nome'),c:normCPF(getCol(r,'CPF MOTORISTA - SOMENTE NUMERO','CPF','cpf')),p:getCol(r,'PLACA \nsem traços e espaços','Placa','placa','PLACA'),f:getCol(r,'FROTA FIXA','Frota Fixa'),s:getCol(r,'PORTAL KANGU','Portal Kangu','Status','status')})).filter(r=>r.n);}
function mapCont(rows){const excluir=['Devolvido para pesca','Substituição de motorista','Falta de interação','Cadastro reprovado','Desistência','Cadastro com erro'];return rows.map(r=>({a:getCol(r,'Assistente','assistente'),id:getCol(r,'ID Demanda','id_demanda'),n:getCol(r,'Nome','nome'),cpf:normCPF(getCol(r,'CPF','cpf')),v:getCol(r,'Perfil do Veículo','Perfil Veículo','Perfil do Ve\u00edculo'),f:getCol(r,'Frota','frota'),m:getCol(r,'Milha','milha'),b:getCol(r,'Base','base'),r:getCol(r,'Regional','regional'),e:getCol(r,'ETC Looker','ETC','etc'),p:getCol(r,'Prioridade','prioridade'),st:getCol(r,'Status','status')})).filter(r=>r.n&&!excluir.includes(r.st));}

let geradoBlob=null,geradoNome='';

async function gerarRelatorio(){
  const url=document.getElementById('sheet-url').value.trim();
  const dateVal=document.getElementById('report-date').value;
  const abaPesca=document.getElementById('aba-pesca').value.trim();
  const abaGUEP=document.getElementById('aba-guep').value.trim();
  const abaCont=document.getElementById('aba-cont').value.trim();
  if(!url){alert('Cole o link da planilha.');return;}
  if(!dateVal){alert('Selecione a data do relatório.');return;}
  const sheetId=getSheetId(url);
  if(!sheetId){alert('Link inválido.');return;}
  const btn=document.getElementById('btn-generate');
  btn.disabled=true;
  document.getElementById('status-area').style.display='block';
  document.getElementById('preview-area').style.display='none';
  for(let i=1;i<=4;i++){const el=document.getElementById(`step-${i}`);el.className='step';el.querySelector('.step-dot').textContent=i;}
  try{
    setStep(1,'active');setStatus('Buscando aba Pesca...');
    const rawPesca=await fetchCSV(csvUrl(sheetId,abaPesca));
    const pesca=mapPesca(filterByDate(rawPesca,dateVal));
    setStep(1,'done');
    setStep(2,'active');setStatus('Buscando aba GUEP...');
    const rawGUEP=await fetchCSV(csvUrl(sheetId,abaGUEP));
    const guep=mapGUEP(filterByDate(rawGUEP,dateVal));
    setStep(2,'done');
    setStep(3,'active');setStatus('Buscando aba Contratação...');
    const rawCont=await fetchCSV(csvUrl(sheetId,abaCont));
    const cont=mapCont(filterByDate(rawCont,dateVal));
    setStep(3,'done');
    setStep(4,'active');setStatus('Gerando relatório...');
    const[y,m,d]=dateVal.split('-');
    const dataExib=`${d}/${m}/${y}`;
    const meses=['','Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    const dataTitulo=`${parseInt(d)} DE ${meses[parseInt(m)].toUpperCase()} DE ${y}`;
    const nomeArq=`relatorio_${d}${meses[parseInt(m)].toLowerCase()}.html`;
    const htmlRel=gerarHTML(pesca,guep,cont,dataExib,dataTitulo);
    geradoBlob=new Blob([htmlRel],{type:'text/html;charset=utf-8'});
    geradoNome=nomeArq;
    setStep(4,'done');
    const contCPFs=new Set(cont.map(r=>r.cpf).filter(Boolean));
    const conv=pesca.length?Math.round(pesca.filter(r=>r.c&&contCPFs.has(r.c)).length/pesca.length*100):0;
    setStatus(`Pronto! ${cont.length} contratados · ${pesca.length} pescados · ${guep.length} GUEP · conversão ${conv}%`,'success');
    document.getElementById('steps-area').style.display='none';
    const sg=document.getElementById('stats-grid');sg.innerHTML='';
    [{n:cont.length,l:'Contratados'},{n:pesca.length,l:'Pescados'},{n:guep.length,l:'GUEP'},{n:conv+'%',l:'Conversão'}].forEach(s=>{sg.innerHTML+=`<div class="stat-card"><div class="stat-num">${s.n}</div><div class="stat-label">${s.l}</div></div>`;});
    document.getElementById('btn-download').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(geradoBlob);a.download=geradoNome;a.click();};
    document.getElementById('preview-area').style.display='block';
  }catch(e){setStatus('Erro: '+e.message,'error');console.error(e);}
  btn.disabled=false;
}

function gerarHTML(pesca,guep,cont,dataExib,dataTitulo){
  const pT=pesca.length,pAp=pesca.filter(r=>r.g==='APROVADO').length,pRe=pesca.filter(r=>r.g==='REPROVADO').length,pPe=pesca.filter(r=>!r.g||r.g==='').length;
  const cT=cont.length,cSp=cont.filter(r=>r.f==='Frota Spot').length,cFx=cont.filter(r=>r.f==='Frota Fixa').length,cEt=cont.filter(r=>r.e==='ETC').length,cFM=cont.filter(r=>r.m==='First Mile').length,cLM=cont.filter(r=>r.m==='Last Mile').length,cFF=cont.filter(r=>r.m==='Fulfillment').length;
  const gT=guep.length,gAp=guep.filter(r=>r.s==='APROVADO').length,gRe=guep.filter(r=>r.s==='REPROVADO').length,gLi=guep.filter(r=>r.s==='LICENCIAMENTO').length,gFa=guep.filter(r=>r.s==='FALTA DOC').length,gPe=guep.filter(r=>r.s&&r.s.includes('PENDENTE')).length;
  const contCPFs=new Set(cont.map(r=>r.cpf).filter(Boolean));
  const pCont=pesca.filter(r=>r.c&&contCPFs.has(r.c));
  const conv=pT?Math.round(pCont.length/pT*100):0;
  const pipeline=pesca.filter(r=>(!r.c||!contCPFs.has(r.c))&&r.g!=='REPROVADO').length;

  return `<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Relatório Diário — ${dataExib}</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"><\/script>
<style>
:root{--blue:#073763;--yellow:#FFE600;--gray:#3d3d3d;--light:#f5f5f0;--muted:#888;--border:#e8e8e2;--orange:#ea580c;--purple:#7c3aed;--red:#dc2626}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',sans-serif;background:var(--light);color:var(--gray);font-size:14px}
header{background:var(--blue);border-bottom:4px solid var(--yellow);padding:20px 32px;display:flex;align-items:center;justify-content:space-between}
header h1{color:#fff;font-size:18px;font-weight:700}
header .date{color:rgba(255,255,255,.6);font-size:12px;margin-top:3px}
.tabs{display:flex;gap:2px;padding:0 32px;background:var(--blue)}
.tab{padding:12px 20px;font-size:13px;font-weight:500;color:rgba(255,255,255,.5);cursor:pointer;border-bottom:3px solid transparent;transition:.2s}
.tab.active{color:#fff;border-bottom-color:var(--yellow)}
.tab-content{display:none;padding:28px 32px}
.tab-content.active{display:block}
.section{margin-bottom:32px}
.section-title{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border)}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:24px}
.kpi-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:16px}
.kpi-card.green{border-left:3px solid var(--blue)}.kpi-card.orange{border-left:3px solid var(--orange)}.kpi-card.red{border-left:3px solid var(--red)}.kpi-card.purple{border-left:3px solid var(--purple)}
.kpi-label{font-size:11px;color:var(--muted);font-weight:500;text-transform:uppercase;letter-spacing:.05em}
.kpi-value{font-size:28px;font-weight:700;color:var(--blue);line-height:1.1;margin:4px 0}
.kpi-sub{font-size:11px;color:var(--muted)}
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
.chart-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:20px}
.chart-card.full{grid-column:1/-1}
.chart-title{font-size:13px;font-weight:600;color:var(--gray);margin-bottom:4px}
.chart-sub{font-size:11px;color:var(--muted);margin-bottom:16px}
.chart-wrap{position:relative;height:200px}.chart-wrap.tall{height:260px}
.insight-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-bottom:24px}
.insight-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:14px 16px}
.insight-card.green{border-left:3px solid var(--blue)}.insight-card.red{border-left:3px solid var(--red)}.insight-card.orange{border-left:3px solid var(--orange)}.insight-card.purple{border-left:3px solid var(--purple)}
.insight-title{font-size:12px;font-weight:600;color:var(--gray);margin-bottom:4px}
.insight-text{font-size:12px;color:var(--muted);line-height:1.5}
.bars-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:20px;margin-bottom:20px}
.bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:12px}
.bar-rank{width:18px;color:var(--muted);font-weight:600;flex-shrink:0;text-align:right}
.bar-name{width:200px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-wrap{flex:1;background:var(--light);border-radius:3px;height:8px}
.bar-fill{height:8px;border-radius:3px}.bar-fill.blue{background:var(--blue)}
.bar-count{width:30px;text-align:right;color:var(--muted);font-weight:600;flex-shrink:0}
.assist-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:24px}
.assistant-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:12px 14px;display:flex;align-items:center;gap:10px}
.assistant-avatar{width:32px;height:32px;background:var(--blue);border-radius:50%;color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.assistant-name{font-size:13px;font-weight:600}.assistant-count{font-size:11px;color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:12px}
th{background:var(--light);color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;font-size:10px;padding:8px 12px;text-align:left;border-bottom:2px solid var(--border)}
td{padding:8px 12px;border-bottom:1px solid var(--border)}
tr:hover td{background:#fafaf7}
.table-wrap{background:#fff;border:1px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:20px;overflow-x:auto}
.badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;letter-spacing:.04em}
.b-aprov{background:rgba(7,55,99,.1);color:var(--blue)}.b-reprov{background:rgba(220,38,38,.1);color:#dc2626}.b-licen{background:rgba(234,88,12,.1);color:#ea580c}.b-falta{background:rgba(124,58,237,.1);color:#7c3aed}.b-pend{background:rgba(107,114,128,.1);color:#6b7280}.b-fixa{background:rgba(255,230,0,.3);color:#5a4700}.b-spot{background:rgba(7,55,99,.08);color:var(--blue)}.b-naocont{background:rgba(107,114,128,.1);color:#6b7280}.b-p0{background:rgba(7,55,99,.9);color:#fff}.b-p1{background:rgba(7,55,99,.5);color:#fff}.b-p2{background:rgba(7,55,99,.15);color:var(--blue)}
.funnel-step{display:flex;align-items:center;gap:16px;padding:16px 20px;background:#fff;border:1px solid var(--border);border-radius:8px;margin-bottom:8px}
.funnel-num{font-size:32px;font-weight:800;color:var(--blue);width:60px;flex-shrink:0}
.funnel-label{font-size:14px;font-weight:600}.funnel-sub{font-size:11px;color:var(--muted)}.funnel-pct{margin-left:auto;font-size:20px;font-weight:700;color:var(--blue)}
.cross-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px}
.cross-card{background:#fff;border:1px solid var(--border);border-radius:8px;padding:16px;text-align:center}
.cross-value{font-size:32px;font-weight:800;margin-bottom:4px}.cross-label{font-size:12px;font-weight:600}.cross-sub{font-size:11px;color:var(--muted);margin-top:2px}
.resumo-box{background:#fff;border:1px solid var(--border);border-radius:8px;padding:20px;margin-bottom:16px}
.resumo-text{font-family:'Courier New',monospace;font-size:12px;line-height:1.8;white-space:pre-wrap}
.btn-copy{padding:12px 24px;background:var(--yellow);color:var(--blue);border:none;border-radius:6px;font-family:'Inter',sans-serif;font-size:13px;font-weight:700;cursor:pointer;display:block;margin:0 auto}
</style>
</head>
<body>
<header><div><h1>📦 Relatório Diário de Contratações</h1><div class="date">${dataTitulo} · Mercado Livre</div></div></header>
<div class="tabs">
  <div class="tab active" onclick="showTab('pesca')">🎣 Pesca</div>
  <div class="tab" onclick="showTab('guep')">🔍 GUEP</div>
  <div class="tab" onclick="showTab('contratacao')">✅ Contratação</div>
  <div class="tab" onclick="showTab('cruzamento')">🔀 Cruzamento</div>
  <div class="tab" onclick="showTab('resumo')">📋 Resumo</div>
</div>
<div id="tab-pesca" class="tab-content active">
  <div class="section"><div class="section-title">KPIs Pesca</div><div class="kpi-grid" id="kpi-pesca"></div></div>
  <div class="section"><div class="section-title">Insights</div><div class="insight-grid" id="insights-pesca"></div></div>
  <div class="section"><div class="charts-grid">
    <div class="chart-card"><div class="chart-title">Tipo de Veículo</div><div class="chart-sub">Distribuição por perfil</div><div class="chart-wrap"><canvas id="cVP"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Tipo de Milha</div><div class="chart-sub">First / Last / Fulfillment</div><div class="chart-wrap"><canvas id="cMP"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Por Regional</div><div class="chart-sub">Volume por regional</div><div class="chart-wrap tall"><canvas id="cRP"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Status GUEP (gerador)</div><div class="chart-sub">Preenchido pelo time de pesca</div><div class="chart-wrap"><canvas id="cGP"></canvas></div></div>
  </div></div>
  <div class="section"><div class="section-title">Top 10 Bases</div><div class="bars-card"><div id="bases-pesca"></div></div></div>
  <div class="section"><div class="section-title">Por Assistente</div><div class="assist-grid" id="assist-pesca"></div></div>
  <div class="section"><div class="section-title">Tabela Completa</div><div class="table-wrap"><table><thead><tr><th>Assistente</th><th>Nome</th><th>Base</th><th>Regional</th><th>Veículo</th><th>Milha</th><th>Status GUEP</th></tr></thead><tbody id="tb-pesca"></tbody></table></div></div>
</div>
<div id="tab-guep" class="tab-content">
  <div class="section"><div class="section-title">KPIs GUEP</div><div class="kpi-grid" id="kpi-guep"></div></div>
  <div class="section"><div class="section-title">Insights</div><div class="insight-grid" id="insights-guep"></div></div>
  <div class="section"><div class="charts-grid">
    <div class="chart-card"><div class="chart-title">Resultado GUEP</div><div class="chart-sub">Distribuição por status oficial</div><div class="chart-wrap"><canvas id="cGS"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Por Responsável</div><div class="chart-sub">Volume validado por assistente</div><div class="chart-wrap tall"><canvas id="cGR"></canvas></div></div>
  </div></div>
  <div class="section"><div class="section-title">Por Responsável</div><div class="assist-grid" id="assist-guep"></div></div>
  <div class="section"><div class="section-title">Tabela Completa</div><div class="table-wrap"><table><thead><tr><th>Responsável</th><th>Nome</th><th>CPF</th><th>Placa</th><th>Frota Fixa</th><th>Status</th></tr></thead><tbody id="tb-guep"></tbody></table></div></div>
</div>
<div id="tab-contratacao" class="tab-content">
  <div class="section"><div class="section-title">KPIs Contratação</div><div class="kpi-grid" id="kpi-cont"></div></div>
  <div class="section"><div class="section-title">Insights</div><div class="insight-grid" id="insights-cont"></div></div>
  <div class="section"><div class="charts-grid">
    <div class="chart-card"><div class="chart-title">Tipo de Veículo</div><div class="chart-sub">Distribuição por perfil</div><div class="chart-wrap"><canvas id="cVC"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Tipo de Milha</div><div class="chart-sub">First / Last / Fulfillment</div><div class="chart-wrap"><canvas id="cMC"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">Frota Spot vs Fixa</div><div class="chart-sub">Distribuição por tipo de frota</div><div class="chart-wrap"><canvas id="cFC"></canvas></div></div>
    <div class="chart-card"><div class="chart-title">ETC vs Não-ETC</div><div class="chart-sub">Com e sem vínculo ETC</div><div class="chart-wrap"><canvas id="cEC"></canvas></div></div>
    <div class="chart-card full"><div class="chart-title">Por Prioridade</div><div class="chart-sub">Distribuição P0/P1/P2/Frota Fixa</div><div class="chart-wrap"><canvas id="cPR"></canvas></div></div>
  </div></div>
  <div class="section"><div class="section-title">Top 10 Bases</div><div class="bars-card"><div id="bases-cont"></div></div></div>
  <div class="section"><div class="section-title">Por Assistente</div><div class="assist-grid" id="assist-cont"></div></div>
  <div class="section"><div class="section-title">Tabela Completa</div><div class="table-wrap"><table><thead><tr><th>Assistente</th><th>ID</th><th>Nome</th><th>Base</th><th>Regional</th><th>Veículo</th><th>Frota</th><th>Milha</th><th>Prior.</th><th>ETC</th></tr></thead><tbody id="tb-cont"></tbody></table></div></div>
</div>
<div id="tab-cruzamento" class="tab-content">
  <div class="section"><div class="section-title">Funil Pesca → Contratação</div><div id="funnel"></div></div>
  <div class="section"><div class="section-title">Métricas de Conversão</div><div class="cross-grid" id="cross-metrics"></div></div>
  <div class="section"><div class="section-title">Insights</div><div class="insight-grid" id="insights-cross"></div></div>
  <div class="section"><div class="charts-grid">
    <div class="chart-card full"><div class="chart-title">Conversão por Regional</div><div class="chart-sub">Pescados vs Contratados</div><div class="chart-wrap"><canvas id="cCR"></canvas></div></div>
    <div class="chart-card full"><div class="chart-title">Conversão por Assistente</div><div class="chart-sub">Pescados vs convertidos</div><div class="chart-wrap"><canvas id="cCA"></canvas></div></div>
  </div></div>
  <div class="section"><div class="section-title">Pipeline Aberto</div><div class="table-wrap"><table><thead><tr><th>Assistente</th><th>Nome</th><th>Base</th><th>Regional</th><th>Veículo</th><th>Status GUEP</th><th>Situação</th></tr></thead><tbody id="tb-pipeline"></tbody></table></div></div>
</div>
<div id="tab-resumo" class="tab-content">
  <div class="section"><div class="section-title">Texto para WhatsApp</div>
    <div class="resumo-box"><pre class="resumo-text" id="resumo-texto"></pre></div>
    <button class="btn-copy" onclick="copyResumo()">COPIAR</button>
  </div>
</div>
<script>
const pesca=${JSON.stringify(pesca)};
const guep=${JSON.stringify(guep)};
const cont=${JSON.stringify(cont)};
const COLORS=['#073763','#FFE600','#3d3d3d','#1a5fa8','#f5c200','#6b6b6b','#0a4d8a','#ccb800','#2a2a2a','#3378c5'];
function countBy(arr,key){return arr.reduce((a,r)=>{const v=r[key]||'N/A';a[v]=(a[v]||0)+1;return a;},{});}
const scOpts=()=>({plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#6b7280',font:{family:'Inter',size:10}},grid:{color:'#e8e8e2'}},y:{ticks:{color:'#6b7280',font:{family:'Inter',size:10}},grid:{color:'#e8e8e2'}}}});
const scHoriz=()=>({plugins:{legend:{display:false}},indexAxis:'y',layout:{padding:{left:10}},scales:{x:{ticks:{color:'#6b7280',font:{family:'Inter',size:10}},grid:{color:'#e8e8e2'}},y:{ticks:{color:'#374151',font:{family:'Inter',size:11},padding:8},grid:{color:'#e8e8e2'}}}});
const scLeg=()=>({plugins:{legend:{labels:{color:'#374151',font:{family:'Inter',size:11}}}},scales:{x:{ticks:{color:'#6b7280',font:{family:'Inter',size:10}},grid:{color:'#e8e8e2'}},y:{ticks:{color:'#6b7280',font:{family:'Inter',size:10}},grid:{color:'#e8e8e2'}}}});
const blPlugin={id:'bl',afterDatasetsDraw(chart){if(chart.config.type!=='bar')return;const{ctx}=chart;chart.data.datasets.forEach((ds,i)=>{chart.getDatasetMeta(i).data.forEach((bar,j)=>{const v=ds.data[j];if(!v)return;const{x,y}=bar.tooltipPosition();ctx.save();ctx.fillStyle='#1a1a2e';ctx.font='600 11px Inter,sans-serif';ctx.textAlign='center';const h=chart.config.options.indexAxis==='y';if(h){ctx.textAlign='left';ctx.textBaseline='middle';ctx.fillText(v,x+6,y);}else{ctx.textBaseline='bottom';ctx.fillText(v,x,y-6);}ctx.restore();});});}};
Chart.register(blPlugin);
function mkDonut(id,labels,data,colors,pid){return new Chart(document.getElementById(id),{type:'doughnut',data:{labels,datasets:[{data,backgroundColor:colors,borderWidth:0,hoverOffset:6}]},options:{plugins:{legend:{position:'bottom',labels:{color:'#374151',font:{family:'Inter',size:11},padding:16,boxWidth:12}}},cutout:'65%'},plugins:[{id:pid,afterDatasetsDraw(c){const{ctx,data}=c;c.getDatasetMeta(0).data.forEach((arc,i)=>{const v=data.datasets[0].data[i];if(!v)return;const{x,y}=arc.tooltipPosition();ctx.save();ctx.fillStyle='#fff';ctx.font='bold 12px Inter,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(v,x,y);ctx.restore();});}}]});}
function renderBars(id,data){const s=Object.entries(data).filter(([b])=>b&&b!=='N/A'&&b!=='').sort((a,b)=>b[1]-a[1]).slice(0,10);const mx=s[0]?s[0][1]:1;const el=document.getElementById(id);s.forEach(([n,c],i)=>{el.innerHTML+=\`<div class="bar-row"><div class="bar-rank">\${i+1}</div><div class="bar-name">\${n}</div><div class="bar-wrap"><div class="bar-fill blue" style="width:\${Math.round(c/mx*100)}%"></div></div><div class="bar-count">\${c}</div></div>\`;});}
function renderAssist(id,data){Object.entries(data).sort((a,b)=>b[1]-a[1]).forEach(([n,c])=>{document.getElementById(id).innerHTML+=\`<div class="assistant-card"><div class="assistant-avatar">\${(n||'?')[0]}</div><div><div class="assistant-name">\${n}</div><div class="assistant-count">\${c} registro\${c>1?'s':''}</div></div></div>\`;});}
function gBadge(s){const m={'APROVADO':'b-aprov','REPROVADO':'b-reprov','LICENCIAMENTO':'b-licen','FALTA DOC':'b-falta'};const cls=m[s]||(s&&s.includes('PENDENTE')?'b-pend':'b-pend');return \`<span class="badge \${cls}">\${s||'—'}</span>\`;}
function kpi(id,items){items.forEach(k=>{document.getElementById(id).innerHTML+=\`<div class="kpi-card \${k.c||''}"><div class="kpi-label">\${k.l}</div><div class="kpi-value">\${k.v}</div><div class="kpi-sub">\${k.s}</div></div>\`;});}
function ins(id,items){items.forEach(i=>{document.getElementById(id).innerHTML+=\`<div class="insight-card \${i.c||''}"><div class="insight-title">\${i.t}</div><div class="insight-text">\${i.x}</div></div>\`;});}
const pT=${pT},pAp=${pAp},pRe=${pRe},pPe=${pPe};
const cT=${cT},cSp=${cSp},cFx=${cFx},cEt=${cEt},cFM=${cFM},cLM=${cLM},cFF=${cFF};
const gT=${gT},gAp=${gAp},gRe=${gRe},gLi=${gLi},gFa=${gFa},gPe=${gPe};
const conv=${conv},pipeline=${pipeline};
// PESCA
const pBases=Object.keys(countBy(pesca,'b')).filter(b=>b&&b!=='N/A').length;
kpi('kpi-pesca',[{l:'Total Pescado',v:pT,s:'motoristas abordados'},{l:'Aprovados Gerador',v:pAp,s:pT?Math.round(pAp/pT*100)+'%':'0%',c:'green'},{l:'Sem Status',v:pPe,s:'não preenchido',c:'orange'},{l:'Assistentes',v:Object.keys(countBy(pesca,'a')).length,s:'ativos'},{l:'Bases',v:pBases,s:'distintas'}]);
const tBP=Object.entries(countBy(pesca,'b')).filter(([b])=>b&&b!=='').sort((a,b)=>b[1]-a[1])[0]||['—',0];
const tAP=Object.entries(countBy(pesca,'a')).sort((a,b)=>b[1]-a[1])[0]||['—',0];
const tRP=Object.entries(countBy(pesca,'r')).filter(([r])=>r&&r!=='N/A'&&r!=='').sort((a,b)=>b[1]-a[1])[0]||['—',0];
ins('insights-pesca',[{c:'',t:'🏆 Base Mais Pescada',x:\`<strong>\${tBP[0]}</strong> liderou com <strong>\${tBP[1]}</strong> abordagens.\`},{c:'green',t:'✅ Aprovação Gerador',x:\`<strong>\${pAp} de \${pT}</strong> (\${pT?Math.round(pAp/pT*100):0}%).\`},{c:'red',t:'🚫 Reprovados',x:\`<strong>\${pRe}</strong> reprovações registradas.\`},{c:'orange',t:'⏳ Sem Status',x:\`<strong>\${pPe}</strong> sem status.\`},{c:'',t:'🗺️ Regional Destaque',x:\`Regional <strong>\${tRP[0]}</strong>.\`},{c:'',t:'👤 Mais Ativo',x:\`<strong>\${tAP[0]}</strong> com <strong>\${tAP[1]}</strong> abordagens.\`}]);
new Chart(document.getElementById('cVP'),{type:'bar',data:{labels:Object.keys(countBy(pesca,'v')),datasets:[{data:Object.values(countBy(pesca,'v')),backgroundColor:COLORS,borderRadius:2}]},options:scOpts()});
mkDonut('cMP',Object.keys(countBy(pesca,'m')).map(k=>k||'N/A'),Object.values(countBy(pesca,'m')),['#073763','#FFE600','#3d3d3d','#a8a8a8'],'mp');
const rPf=Object.fromEntries(Object.entries(countBy(pesca,'r')).filter(([k])=>k&&k!=='N/A'));
new Chart(document.getElementById('cRP'),{type:'bar',data:{labels:Object.keys(rPf),datasets:[{data:Object.values(rPf),backgroundColor:COLORS,borderRadius:2}]},options:scHoriz()});
const gPC=countBy(pesca,'g');mkDonut('cGP',Object.keys(gPC).map(k=>k||'Pendente'),Object.values(gPC),['#073763','#3d3d3d','#a8a8a8','#FFE600'],'gp');
renderBars('bases-pesca',countBy(pesca,'b'));renderAssist('assist-pesca',countBy(pesca,'a'));
pesca.forEach(r=>{document.getElementById('tb-pesca').innerHTML+=\`<tr><td>\${r.a}</td><td>\${r.n}</td><td>\${r.b||'—'}</td><td>\${r.r||'—'}</td><td>\${r.v}</td><td>\${r.m||'—'}</td><td>\${gBadge(r.g)}</td></tr>\`;});
// GUEP
kpi('kpi-guep',[{l:'Total Validado',v:gT,s:'registros'},{l:'Aprovados',v:gAp,s:gT?Math.round(gAp/gT*100)+'%':'0%',c:'green'},{l:'Reprovados',v:gRe,s:'não seguem',c:'red'},{l:'Licenciamento',v:gLi,s:'licenc. vencido',c:'orange'},{l:'Falta Doc',v:gFa,s:'incompleto',c:'purple'},{l:'Pendentes',v:gPe,s:'aguardando'}]);
const tAG=Object.entries(countBy(guep,'r')).sort((a,b)=>b[1]-a[1])[0]||['—',0];
ins('insights-guep',[{c:'green',t:'✅ Taxa Aprovação',x:\`<strong>\${gAp} de \${gT}</strong> — <strong>\${gT?Math.round(gAp/gT*100):0}%</strong>.\`},{c:'red',t:'🚫 Não Aprovados',x:\`\${gRe} reprov. · \${gLi} licenc. · \${gFa} falta doc · \${gPe} pendentes.\`},{c:'orange',t:'🚗 Licenciamento',x:\`<strong>\${gLi}</strong> podem regularizar.\`},{c:'purple',t:'📄 Falta Doc',x:\`<strong>\${gFa}</strong> recuperáveis.\`},{c:'',t:'👤 Mais Ativo',x:\`<strong>\${tAG[0]}</strong> com <strong>\${tAG[1]}</strong> validações.\`}]);
const stOrdem=['APROVADO','REPROVADO','LICENCIAMENTO','FALTA DOC','PENDENTE ENVIO p/ GUEP','PENDENTE RETORNO GUEP'];
const stC={'APROVADO':'#073763','REPROVADO':'#3d3d3d','LICENCIAMENTO':'#FFE600','FALTA DOC':'#1a5fa8','PENDENTE ENVIO p/ GUEP':'#9ca3af','PENDENTE RETORNO GUEP':'#6b7280'};
const gStRaw=countBy(guep,'s');const gStL=stOrdem.filter(k=>gStRaw[k]);
new Chart(document.getElementById('cGS'),{type:'doughnut',data:{labels:gStL,datasets:[{data:gStL.map(k=>gStRaw[k]),backgroundColor:gStL.map(k=>stC[k]||'#9ca3af'),borderWidth:0,hoverOffset:6}]},options:{plugins:{legend:{position:'bottom',labels:{color:'#374151',font:{family:'Inter',size:11},padding:16,boxWidth:12}}},cutout:'60%'},plugins:[{id:'gs',afterDatasetsDraw(c){const{ctx,data}=c;c.getDatasetMeta(0).data.forEach((arc,i)=>{const v=data.datasets[0].data[i];if(!v)return;const{x,y}=arc.tooltipPosition();ctx.save();ctx.fillStyle='#fff';ctx.font='bold 11px Inter,sans-serif';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(v,x,y);ctx.restore();});}}]});
const gRS=Object.entries(countBy(guep,'r')).sort((a,b)=>b[1]-a[1]);
new Chart(document.getElementById('cGR'),{type:'bar',data:{labels:gRS.map(([k])=>k),datasets:[{data:gRS.map(([,v])=>v),backgroundColor:'#073763',borderRadius:2}]},options:scHoriz()});
renderAssist('assist-guep',Object.fromEntries(gRS));
guep.forEach(r=>{document.getElementById('tb-guep').innerHTML+=\`<tr><td>\${r.r}</td><td>\${r.n}</td><td style="color:var(--muted)">\${r.c||'—'}</td><td style="color:var(--muted)">\${r.p||'—'}</td><td>\${r.f?\`<span class="badge b-fixa">\${r.f}</span>\`:'—'}</td><td>\${gBadge(r.s)}</td></tr>\`;});
// CONTRATAÇÃO
const tBC=Object.entries(countBy(cont,'b')).filter(([b])=>b&&b!=='').sort((a,b)=>b[1]-a[1])[0]||['—',0];
const tVC=Object.entries(countBy(cont,'v')).sort((a,b)=>b[1]-a[1])[0]||['—',0];
const tRC=Object.entries(countBy(cont,'r')).filter(([r])=>r&&r!=='N/A'&&r!=='').sort((a,b)=>b[1]-a[1])[0]||['—',0];
const p0c=cont.filter(r=>r.p==='P0').length;
kpi('kpi-cont',[{l:'Total Contratado',v:cT,s:'registros'},{l:'Frota Spot',v:cSp,s:cT?Math.round(cSp/cT*100)+'%':'0%'},{l:'Frota Fixa',v:cFx,s:cT?Math.round(cFx/cT*100)+'%':'0%',c:'orange'},{l:'Com ETC',v:cEt,s:cT?Math.round(cEt/cT*100)+'%':'0%',c:'green'},{l:'First Mile',v:cFM,s:cT?Math.round(cFM/cT*100)+'%':'0%'},{l:'Last Mile',v:cLM,s:cT?Math.round(cLM/cT*100)+'%':'0%'},{l:'Assistentes',v:Object.keys(countBy(cont,'a')).length,s:'ativos'},{l:'Bases',v:Object.keys(countBy(cont,'b')).filter(b=>b&&b!=='').length,s:'distintas'}]);
ins('insights-cont',[{c:'',t:'🏆 Base Líder',x:\`<strong>\${tBC[0]}</strong> com <strong>\${tBC[1]}</strong> contratações.\`},{c:'',t:'🚚 Veículo Mais Contratado',x:\`<strong>\${tVC[0]}</strong> com <strong>\${tVC[1]}</strong> unidades.\`},{c:'green',t:'🔗 Penetração ETC',x:\`<strong>\${cEt} (\${cT?Math.round(cEt/cT*100):0}%)</strong> via ETC.\`},{c:'red',t:'⚡ Demandas P0',x:\`<strong>\${p0c} urgentes (P0)</strong>.\`},{c:'',t:'🗺️ Regional Líder',x:\`<strong>\${tRC[0]}</strong>.\`},{c:'orange',t:'📦 Frota Fixa',x:\`<strong>\${cFx} (\${cT?Math.round(cFx/cT*100):0}%)</strong>.\`}]);
new Chart(document.getElementById('cVC'),{type:'bar',data:{labels:Object.keys(countBy(cont,'v')),datasets:[{data:Object.values(countBy(cont,'v')),backgroundColor:COLORS,borderRadius:2}]},options:scOpts()});
mkDonut('cMC',Object.keys(countBy(cont,'m')).map(k=>k||'N/A'),Object.values(countBy(cont,'m')),['#073763','#FFE600','#3d3d3d','#a8a8a8'],'mc');
mkDonut('cFC',['Spot','Fixa'],[cSp,cFx],['#073763','#FFE600'],'fc');
mkDonut('cEC',['Com ETC','Sem ETC'],[cEt,cT-cEt],['#073763','#3d3d3d'],'ec');
const prC=countBy(cont,'p');new Chart(document.getElementById('cPR'),{type:'bar',data:{labels:Object.keys(prC),datasets:[{data:Object.values(prC),backgroundColor:['#073763','#3d3d3d','#FFE600','#1a5fa8','#a0a0a0'],borderRadius:2}]},options:scHoriz()});
renderBars('bases-cont',countBy(cont,'b'));renderAssist('assist-cont',countBy(cont,'a'));
